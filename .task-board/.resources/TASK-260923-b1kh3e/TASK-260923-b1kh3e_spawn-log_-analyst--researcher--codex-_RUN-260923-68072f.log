 300  func (p *parser) expect(typ tokenType) (token, error) {
 301  	tok := p.advance()
 302  	if tok.typ != typ {
 303  		pos := p.tzer.posAt(tok.pos)
 304  		got := tok.val
 305  		if tok.typ == tokenEOF {
 306  			got = "end of input"
 307  		}
 308  		return tok, &ParseError{
 309  			Message:  fmt.Sprintf("expected %s", tokenTypeName(typ)),
 310  			Pos:      pos,
 311  			Got:      got,
 312  			Expected: tokenTypeName(typ),
 313  		}
 314  	}
 315  	return tok, nil
 316  }

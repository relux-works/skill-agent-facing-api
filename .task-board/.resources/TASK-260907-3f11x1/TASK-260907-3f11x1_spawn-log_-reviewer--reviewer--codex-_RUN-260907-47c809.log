   131	func statementForms(q *Query) map[string]bool {
   132		forms := make(map[string]bool)
   133		if len(q.Statements) > 1 {
   134			forms["batch"] = true
   135		}
   136		for _, statement := range q.Statements {
   137			if len(statement.Fields) > 0 {
   138				forms["projection"] = true
   139			}
   140			for _, arg := range statement.Args {
   141				if arg.Key == "" {
   142					forms["positional"] = true
   143				} else {
   144					forms["key=value"] = true
   145				}
   146				if strings.ContainsAny(arg.Value, " \t\n,()") {
   147					forms["quoted"] = true
   148				}
   149			}
   150		}
   151		return forms
   152	}

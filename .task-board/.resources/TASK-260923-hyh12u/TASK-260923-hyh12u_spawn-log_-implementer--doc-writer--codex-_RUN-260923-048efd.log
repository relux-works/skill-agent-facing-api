+#!/usr/bin/env python3
+"""Focused documentation regressions requested by revision-1 review."""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from pathlib import Path
+from urllib.parse import unquote
+
+
+ROOT = Path(__file__).resolve().parents[2]
+ARTICLE = ROOT / "articles/field-alias-compression-study.md"
+README = ROOT / "README.md"
+RESEARCH = ROOT / ".research/260923_mcp-token-economics-evidence.md"
+DOCS = (ARTICLE, README, RESEARCH)
+
+
+def test_composed_document_whitespace(contents: dict[Path, str]) -> None:
+    failures = [
+        f"{path.relative_to(ROOT)}:{number}"
+        for path, text in contents.items()
+        for number, line in enumerate(text.splitlines(), 1)
+        if line.endswith((" ", "\t"))
+    ]
+    assert not failures, f"trailing whitespace: {', '.join(failures)}"
+
+
+def test_break_even_and_net_positive_bounds(contents: dict[Path, str]) -> None:
+    article = contents[ARTICLE]
+    assert "break_even_queries >= schema_cost / savings_per_query" in article
+    assert "net_positive_queries > schema_cost / savings_per_query" in article
+    assert re.search(
+        r"17 such data queries exactly amortize one schema roundtrip;\s+"
+        r"net-positive savings begin at 18\.",
+        article,
+    ), "article must distinguish break-even at 17 from net-positive at 18"
+
+
+def test_readme_index_evidence_classification(contents: dict[Path, str]) -> None:
+    readme = contents[README]
+    row = next(
+        line
+        for line in readme.splitlines()
+        if "articles/field-alias-compression-study.md" in line
+    )
+    required = (
+        "historical measurements",
+        "session model is conditional",
+        "hard-coded discovery cost, query mix, and eviction assumptions",
+        "no repository-local MCP benchmark",
+    )
+    missing = [phrase for phrase in required if phrase not in row]
+    assert not missing, f"README article row lacks boundaries: {missing}"
+
+
+def test_local_markdown_targets(contents: dict[Path, str]) -> None:
+    missing: list[str] = []
+    link_pattern = re.compile(r"\[[^\]]+\]\(([^)]+)\)")
+    for source, text in contents.items():
+        for raw_target in link_pattern.findall(text):
+            target = raw_target.strip()
+            if target.startswith(("http://", "https://", "mailto:", "board-resource:")):
+                continue
+            path_part = unquote(target.split("#", 1)[0])
+            if not path_part:
+                continue
+            resolved = (source.parent / path_part).resolve()
+            if not resolved.exists():
+                missing.append(f"{source.relative_to(ROOT)} -> {target}")
+    assert not missing, f"missing local link targets: {missing}"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--narrow-net-positive-bound", action="store_true")
+    args = parser.parse_args()
+
+    contents = {path: path.read_text(encoding="utf-8") for path in DOCS}
+    if args.narrow_net_positive_bound:
+        original = "net-positive savings begin at 18."
+        narrowed = "net-positive savings begin at 19."
+        assert original in contents[ARTICLE], "narrowing mutant target is absent"
+        contents[ARTICLE] = contents[ARTICLE].replace(original, narrowed, 1)
+
+    tests = (
+        test_composed_document_whitespace,
+        test_break_even_and_net_positive_bounds,
+        test_readme_index_evidence_classification,
+        test_local_markdown_targets,
+    )
+    failures: list[str] = []
+    for test in tests:
+        try:
+            test(contents)
+            print(f"PASS {test.__name__}")
+        except (AssertionError, StopIteration) as error:
+            failures.append(test.__name__)
+            print(f"FAIL {test.__name__}: {error}")
+
+    if args.narrow_net_positive_bound and "test_break_even_and_net_positive_bounds" not in failures:
+        print("FAIL narrowing mutant survived")
+        return 2
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

			}
			return nil, &ParseError{
				Message:  "expected value after '='",
				Pos:      pos,
				Got:      got,
				Expected: "identifier or string",
			}
		}
		return &Arg{Key: tok.val, Value: valTok.val, Pos: argPos}, nil
	}

	// Positional argument
	return &Arg{Value: tok.val, Pos: argPos}, nil
}


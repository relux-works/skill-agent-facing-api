   1  #!/usr/bin/env python3
   2  """
   3  Measure token counts for synthetic payloads using tiktoken (cl100k_base).
   4  
   5  Produces a comparison table showing:
   6  - Raw token counts per variant per scale
   7  - % savings: JSON -> compact-full
   8  - % savings: compact-full -> compact-aliased (marginal benefit of abbreviation)
   9  - Absolute token savings from aliases per scale
  10  """
  11  
  12  import os
  13  import tiktoken
  14  
  15  SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
  16  SCALES = [5, 20, 100, 500]
  17  VARIANTS = ["json", "compact-full", "compact-alias"]
  18  
  19  enc = tiktoken.get_encoding("cl100k_base")
  20  
  21  
  22  def count_tokens(text: str) -> int:
  23      return len(enc.encode(text))
  24  
  25  
  26  def read_payload(variant: str, scale: int) -> str:
  27      path = os.path.join(SCRIPT_DIR, f"{variant}-{scale}.txt")
  28      with open(path, "r") as f:
  29          return f.read()
  30  
  31  
  32  def main():
  33      # Collect measurements
  34      data = {}  # data[scale][variant] = token_count
  35      byte_sizes = {}  # byte_sizes[scale][variant] = byte_count
  36  
  37      for scale in SCALES:
  38          data[scale] = {}
  39          byte_sizes[scale] = {}
  40          for variant in VARIANTS:
  41              text = read_payload(variant, scale)
  42              tokens = count_tokens(text)
  43              data[scale][variant] = tokens
  44              byte_sizes[scale][variant] = len(text.encode("utf-8"))
  45              print(f"  {variant}-{scale}: {tokens:,} tokens ({len(text.encode('utf-8')):,} bytes)")
  46  
  47      print()
  48  
  49      # Build markdown report
  50      lines = []
  51      lines.append("# Field Alias Token Measurement Results")
  52      lines.append("")
  53      lines.append("**Date:** 2026-02-12")
  54      lines.append("**Encoding:** cl100k_base (GPT-4 / Claude-compatible BPE tokenizer)")
  55      lines.append("**Seed:** 42 (reproducible)")
  56      lines.append("")
  57      lines.append("## Methodology")
  58      lines.append("")
  59      lines.append("Generated synthetic task tracker payloads at 4 scales (5, 20, 100, 500 items)")
  60      lines.append("with 8 fields per item: id, name, status, assignee, description, priority, created, updated.")
  61      lines.append("")
  62      lines.append("Three format variants per scale:")
  63      lines.append("- **JSON**: Standard `json.dumps(items, indent=2)` — pretty-printed JSON array")
  64      lines.append("- **Compact-full**: CSV-style with full field names as header, data rows below")
  65      lines.append("- **Compact-alias**: Same CSV-style but header uses 1-char abbreviations (id->i, name->n, etc.)")
  66      lines.append("")
  67      lines.append("Token counts measured with `tiktoken` using `cl100k_base` encoding.")
  68      lines.append("")
  69  
  70      # Table 1: Raw counts
  71      lines.append("## 1. Raw Token Counts")
  72      lines.append("")
  73      lines.append("| Scale | JSON | Compact-Full | Compact-Alias | JSON bytes | Compact-Full bytes | Compact-Alias bytes |")
  74      lines.append("|------:|-----:|-------------:|--------------:|-----------:|-------------------:|--------------------:|")
  75      for scale in SCALES:
  76          j = data[scale]["json"]
  77          cf = data[scale]["compact-full"]
  78          ca = data[scale]["compact-alias"]
  79          jb = byte_sizes[scale]["json"]
  80          cfb = byte_sizes[scale]["compact-full"]
  81          cab = byte_sizes[scale]["compact-alias"]
  82          lines.append(f"| {scale} | {j:,} | {cf:,} | {ca:,} | {jb:,} | {cfb:,} | {cab:,} |")
  83      lines.append("")
  84  
  85      # Table 2: JSON -> Compact-Full savings
  86      lines.append("## 2. Savings: JSON to Compact-Full")
  87      lines.append("")
  88      lines.append("| Scale | JSON Tokens | Compact-Full Tokens | Saved | % Reduction |")
  89      lines.append("|------:|------------:|--------------------:|------:|------------:|")
  90      for scale in SCALES:
  91          j = data[scale]["json"]
  92          cf = data[scale]["compact-full"]
  93          saved = j - cf
  94          pct = (saved / j) * 100
  95          lines.append(f"| {scale} | {j:,} | {cf:,} | {saved:,} | {pct:.1f}% |")
  96      lines.append("")
  97  
  98      # Table 3: Compact-Full -> Compact-Alias savings (THE KEY METRIC)
  99      lines.append("## 3. Marginal Savings: Compact-Full to Compact-Alias (KEY METRIC)")
 100      lines.append("")
 101      lines.append("This measures the **incremental benefit** of abbreviating field names in the header,")
 102      lines.append("given that we already use compact tabular format.")
 103      lines.append("")
 104      lines.append("| Scale | Compact-Full Tokens | Compact-Alias Tokens | Tokens Saved | % Reduction | Bytes Saved |")
 105      lines.append("|------:|--------------------:|---------------------:|-------------:|------------:|------------:|")

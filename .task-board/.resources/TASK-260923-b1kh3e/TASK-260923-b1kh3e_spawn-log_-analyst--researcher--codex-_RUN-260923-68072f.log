   7  
   8  // Query parses and executes the input query string against the schema.
   9  // For a single statement, it returns the handler's result directly.
  10  // For multiple semicolon-separated statements (batch), it returns []any
  11  // where each element is either the handler's result or an error map.
  12  // Per-statement errors do not abort the batch — remaining statements
  13  // continue executing.
  14  func (s *Schema[T]) Query(input string) (any, error) {
  15  	q, err := s.Parse(input)
  16  	if err != nil {
  17  		return nil, err
  18  	}
  19  	return s.QueryAST(q)
  20  }
  21  
  22  // Parse parses input with this schema's operation and field validation.
  23  func (s *Schema[T]) Parse(input string) (*Query, error) {
  24  	return Parse(input, s.parserConfig())
  25  }
  26  
  27  // QueryAST executes an already parsed query without parsing the DSL again.
  28  // Callers that need to inspect or transform statements before execution can
  29  // therefore keep one AST as the source of truth.
  30  func (s *Schema[T]) QueryAST(q *Query) (any, error) {
  31  	if q == nil || len(q.Statements) == 0 {
  32  		return nil, &ParseError{
  33  			Message: "empty query",
  34  			Pos:     Pos{Line: 1, Column: 1},
  35  			Got:     "end of input",
  36  		}
  37  	}
  38  	if err := s.ValidateAST(q); err != nil {
  39  		return nil, err
  40  	}
  41  	results := make([]any, 0, len(q.Statements))
  42  	for _, stmt := range q.Statements {
  43  		result, execErr := s.executeStatement(stmt)
  44  		if execErr != nil {
  45  			results = append(results, map[string]any{
  46  				"error": map[string]any{
  47  					"message": execErr.Error(),
  48  				},
  49  			})
  50  			continue
  51  		}
  52  		results = append(results, result)
  53  	}
  54  
  55  	// Single statement: return unwrapped result
  56  	if len(results) == 1 {
  57  		return results[0], nil
  58  	}
  59  
  60  	return results, nil
  61  }
  62  
  63  // ValidateAST applies the schema's operation and field contract to an AST that
  64  // may have been parsed permissively before the concrete schema was selected.
  65  func (s *Schema[T]) ValidateAST(q *Query) error {
  66  	if q == nil || len(q.Statements) == 0 {
  67  		return &ParseError{Message: "empty query", Pos: Pos{Line: 1, Column: 1}, Got: "end of input"}
  68  	}
  69  	for _, statement := range q.Statements {
  70  		if _, ok := s.operations[statement.Operation]; !ok {
  71  			return NewUnknownOperationError(statement.Operation, statement.Pos, s.operationNames())
  72  		}
  73  		if _, err := s.newSelector(statement.Fields); err != nil {
  74  			return &ParseError{
  75  				Message: err.Error(),
  76  				Pos:     statement.Pos,
  77  			}
  78  		}
  79  	}
  80  	return nil
  81  }
  82  
  83  // QueryJSON is a convenience method that executes the query and marshals
  84  // the result to JSON bytes.
  85  func (s *Schema[T]) QueryJSON(input string) ([]byte, error) {
  86  	result, err := s.Query(input)
  87  	if err != nil {
  88  		return nil, err
  89  	}
  90  	return json.Marshal(result)
  91  }
  92  
  93  // QueryJSONAST executes an already parsed query and marshals the result.
  94  func (s *Schema[T]) QueryJSONAST(q *Query) ([]byte, error) {
  95  	result, err := s.QueryAST(q)
  96  	if err != nil {
  97  		return nil, err
  98  	}
  99  	return json.Marshal(result)
 100  }

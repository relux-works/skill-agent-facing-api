+func statementForms(q *Query) map[string]bool {
+	forms := make(map[string]bool)
+	if len(q.Statements) > 1 {
+		forms["batch"] = true
+	}
+	for _, statement := range q.Statements {
+		if len(statement.Fields) > 0 {

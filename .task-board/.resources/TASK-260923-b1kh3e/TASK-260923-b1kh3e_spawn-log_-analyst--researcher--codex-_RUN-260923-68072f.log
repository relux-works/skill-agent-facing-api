 156          j_cf_pcts.append(((j - cf) / j) * 100)
 157  
 158      avg_j_cf = sum(j_cf_pcts) / len(j_cf_pcts)
 159      avg_cf_ca = sum(cf_ca_pcts) / len(cf_ca_pcts)
 160  
 161      lines.append("### JSON to Compact-Full: Large, Consistent Win")
 162      lines.append("")
 163      lines.append(f"Switching from JSON to compact tabular format saves **~{avg_j_cf:.0f}%** of tokens on average.")
 164      lines.append("This is a substantial reduction driven by eliminating:")
 165      lines.append("- Repeated field name keys on every item")
 166      lines.append("- JSON structural characters (`{{`, `}}`, `[`, `]`, `:`, `\"`)")
 167      lines.append("- Indentation whitespace")
 168      lines.append("")
 169      lines.append("The savings scale well: they remain consistent as item count grows,")
 170      lines.append("because the overhead is proportional to the number of items in JSON.")
 171      lines.append("")
 172  
 173      lines.append("### Compact-Full to Compact-Alias: Negligible Marginal Benefit")
 174      lines.append("")
 175      lines.append(f"Abbreviating field names in the header saves **~{avg_cf_ca:.2f}%** of tokens on average.")
 176      lines.append(f"In absolute terms, the savings are **{cf_ca_abs[0]} tokens** (5 items) to **{cf_ca_abs[-1]} tokens** (500 items).")
 177      lines.append("")
 178      lines.append("Why so small? Because in the compact format, field names appear **only once** — in the header row.")
 179      lines.append("The header `id,name,status,assignee,description,priority,created,updated` is a single line")
 180      lines.append("consuming a fixed number of tokens regardless of how many data rows follow.")
 181      lines.append("Abbreviating it to `i,n,s,a,d,p,c,u` saves those few tokens once, and that's it.")
 182      lines.append("")
 183      lines.append("The data rows (which dominate the payload) are identical in both variants.")
 184      lines.append("")
 185  
 186      lines.append("### Cost-Benefit Verdict")
 187      lines.append("")
 188      lines.append("| Factor | Assessment |")
 189      lines.append("|--------|-----------|")
 190      lines.append(f"| Token savings | {avg_cf_ca:.2f}% average — negligible |")
 191      lines.append(f"| Absolute savings at 500 items | {cf_ca_abs[-1]} tokens — trivial |")
 192      lines.append("| Readability cost | High — `i,n,s,a,d,p,c,u` is unreadable without a legend |")
 193      lines.append("| Implementation complexity | Moderate — need alias registry, mapping, docs |")
 194      lines.append("| Agent confusion risk | Non-trivial — agents may misinterpret abbreviated headers |")
 195      lines.append("| Schema discoverability | Degraded — header no longer self-documenting |")
 196      lines.append("")
 197      lines.append("**Recommendation: Do NOT implement field name aliases.**")
 198      lines.append("")
 199      lines.append("The marginal token savings are negligible compared to the readability and complexity costs.")
 200      lines.append("The big win is already captured by switching from JSON to compact tabular format.")
 201      lines.append("Further compression efforts should target the data values themselves (e.g., date format")
 202      lines.append("abbreviation, status code mapping) rather than the one-time header line, though even those")
 203      lines.append("are unlikely to be worth the tradeoff.")
 204      lines.append("")
 205  
 206      # Write report
 207      report_path = os.path.join(SCRIPT_DIR, "..", "260212_field-alias-token-measurements.md")
 208      report_path = os.path.normpath(report_path)
 209      with open(report_path, "w") as f:
 210          f.write("\n".join(lines))
 211      print(f"Report written to: {report_path}")
 212  
 213      # Also print summary
 214      print("\n=== SUMMARY ===")
 215      print(f"JSON -> Compact-Full:  ~{avg_j_cf:.0f}% token reduction (BIG WIN)")
 216      print(f"Compact-Full -> Alias: ~{avg_cf_ca:.2f}% token reduction (NEGLIGIBLE)")
 217      print(f"Absolute alias savings: {cf_ca_abs[0]}-{cf_ca_abs[-1]} tokens across scales")
 218  

 221      main()
   1  #!/usr/bin/env python3
   2  """
   3  Session Simulator: Model the token economics of field-name aliases
   4  across agent sessions of varying lengths.
   5  
   6  Core question: Does the token savings from abbreviated field names
   7  justify the schema() lookup overhead required when the alias dictionary
   8  gets evicted from context?
   9  
  10  Uses real measured token counts from the agentquery example CLI.
  11  """
  12  
  13  import itertools
  14  import json
  15  import os
  16  import sys
  17  
  18  # ===========================================================================
  19  # MEASURED CONSTANTS (from tiktoken cl100k_base on real CLI outputs)
  20  # ===========================================================================
  21  
  22  # Schema call: agent sends tool call + receives schema response
  23  SCHEMA_CALL_TOKENS = 10      # tool call overhead
  24  SCHEMA_RESPONSE_TOKENS = 71  # schema() JSON output
  25  SCHEMA_RESULT_OVERHEAD = 4   # "Tool output: " prefix
  26  SCHEMA_TOTAL_ROUNDTRIP = SCHEMA_CALL_TOKENS + SCHEMA_RESPONSE_TOKENS + SCHEMA_RESULT_OVERHEAD  # = 85
  27  
  28  # Per-query alias savings in compact format
  29  # From token measurement research: aliases save exactly 5 tokens per list() call
  30  # (header-only savings, data rows identical)
  31  # For get() with a single item: field names appear in the object keys, saving ~3-5 tokens
  32  # For JSON format: aliases save ~2-4 tokens per item (key names repeated per item)
  33  ALIAS_SAVINGS_PER_QUERY = {
  34      "compact_list": 5,    # Fixed: header abbreviation saves 5 tokens regardless of item count
  35      "compact_get": 5,     # Same header savings for single-item display
  36      "json_get": 3,        # JSON: ~3 tokens saved per single-item query (shorter keys)
  37      "json_list_per_item": 3,  # JSON: ~3 tokens saved per item in list (key names per item)
  38  }
  39  
  40  # Query result token costs (for reference / workflow modeling)
  41  QUERY_COSTS = {
  42      "get_overview": 23,    # get(id=X) { overview } result
  43      "get_full": 35,        # get(id=X) { full } result (estimated)
  44      "list_overview_8": 177,  # list() { overview } with 8 items
  45      "list_overview_20": 440, # estimated for 20 items
  46      "summary": 20,         # summary() result
  47  }
  48  
  49  # ===========================================================================
  50  # SIMULATION PARAMETERS
  51  # ===========================================================================
  52  
  53  SESSION_LENGTHS = [10, 20, 50, 100]
  54  CONTEXT_EVICTION_RATES = [10, 20, 50, float('inf')]  # K turns before eviction; inf = never
  55  OUTPUT_FORMATS = ["compact", "json"]
  56  
  57  # Typical query mix in a session (proportions)
  58  QUERY_MIX = {
  59      "get": 0.50,   # 50% of queries are get() for single items
  60      "list": 0.30,  # 30% are list() queries
  61      "summary": 0.10,  # 10% are summary() queries
  62      "other": 0.10,  # 10% are other/mutations (no alias benefit)
  63  }
  64  
  65  # Average items per list() query
  66  AVG_LIST_ITEMS = 10
  67  
  68  
  69  def calculate_schema_calls(session_length: int, eviction_rate: float) -> int:
  70      """
  71      Calculate how many schema() calls an agent needs in a session.
  72  
  73      First call is always needed (to learn the alias dictionary).
  74      Subsequent calls happen every K turns when context gets evicted.
  75      """
  76      if eviction_rate == float('inf'):
  77          return 1  # Only the initial call, dictionary never evicted
  78  
  79      # Initial call + one call per eviction cycle
  80      return 1 + max(0, (session_length - 1) // int(eviction_rate))
  81  
  82  
  83  def calculate_alias_savings_per_query(output_format: str, query_type: str) -> float:
  84      """
  85      Calculate token savings from aliases for a single query.
  86  
  87      In compact format: only header is abbreviated → fixed 5 tokens per query
  88      In JSON format: keys abbreviated per item → scales with item count
  89      """
  90      if query_type == "other" or query_type == "summary":
  91          return 0  # No field name savings for summary/mutations
  92  
  93      if output_format == "compact":
  94          return ALIAS_SAVINGS_PER_QUERY["compact_list"]  # 5 tokens, always
  95  
  96      # JSON format
  97      if query_type == "get":
  98          return ALIAS_SAVINGS_PER_QUERY["json_get"]  # ~3 tokens
  99      elif query_type == "list":
 100          return ALIAS_SAVINGS_PER_QUERY["json_list_per_item"] * AVG_LIST_ITEMS  # ~30 tokens
 101      return 0
 102  
 103  
 104  def simulate_session(
 105      session_length: int,
 106      eviction_rate: float,
 107      output_format: str,
 108  ) -> dict:
 109      """
 110      Simulate a full agent session and calculate token economics.
 111  
 112      Returns a dict with all metrics.
 113      """
 114      # Schema overhead
 115      schema_calls = calculate_schema_calls(session_length, eviction_rate)
 116      total_schema_cost = schema_calls * SCHEMA_TOTAL_ROUNDTRIP
 117  
 118      # Alias savings across all queries
 119      total_savings = 0
 120      query_breakdown = {}
 121  
 122      for qtype, proportion in QUERY_MIX.items():
 123          n_queries = int(session_length * proportion)
 124          per_query_saving = calculate_alias_savings_per_query(output_format, qtype)
 125          type_savings = n_queries * per_query_saving
 126          total_savings += type_savings
 127          query_breakdown[qtype] = {
 128              "count": n_queries,
 129              "savings_per_query": per_query_saving,
 130              "total_savings": type_savings,
 131          }
 132  
 133      net_balance = total_savings - total_schema_cost
 134  
 135      # Break-even: how many queries until savings >= schema cost
 136      avg_saving_per_query = total_savings / session_length if session_length > 0 else 0
 137      if avg_saving_per_query > 0:
 138          # Account for ongoing schema costs
 139          savings_per_cycle = avg_saving_per_query * (eviction_rate if eviction_rate != float('inf') else session_length)
 140          if savings_per_cycle > SCHEMA_TOTAL_ROUNDTRIP:
 141              # Can break even within a cycle
 142              break_even = SCHEMA_TOTAL_ROUNDTRIP / avg_saving_per_query
 143          else:
 144              break_even = float('inf')  # Never breaks even
 145      else:
 146          break_even = float('inf')
 147  
 148      return {
 149          "session_length": session_length,
 150          "eviction_rate": eviction_rate,
 151          "output_format": output_format,
 152          "schema_calls": schema_calls,
 153          "total_schema_cost": total_schema_cost,
 154          "total_alias_savings": total_savings,
 155          "net_balance": net_balance,
 156          "break_even_queries": break_even,
 157          "avg_saving_per_query": avg_saving_per_query,
 158          "query_breakdown": query_breakdown,
 159      }
 160  
 161  
 162  def format_eviction(k):
 163      return "never" if k == float('inf') else str(int(k))
 164  
 165  
 166  def main():
 167      results = []
 168  
 169      # Run all parameter combinations
 170      for session_len, eviction_k, fmt in itertools.product(
 171          SESSION_LENGTHS, CONTEXT_EVICTION_RATES, OUTPUT_FORMATS
 172      ):
 173          result = simulate_session(session_len, eviction_k, fmt)
 174          results.append(result)
 175  
 176      # Build output report
 177      lines = []
 178      lines.append("# Session Simulator Results")
 179      lines.append("")
 180      lines.append("**Date:** 2026-02-12")
 181      lines.append("**Purpose:** Model token economics of field-name aliases across agent sessions")
 182      lines.append("")
 183      lines.append("## Measured Constants")
 184      lines.append("")
 185      lines.append(f"- Schema() roundtrip cost: **{SCHEMA_TOTAL_ROUNDTRIP} tokens** (call={SCHEMA_CALL_TOKENS} + response={SCHEMA_RESPONSE_TOKENS} + overhead={SCHEMA_RESULT_OVERHEAD})")
 186      lines.append(f"- Alias savings per query (compact format): **{ALIAS_SAVINGS_PER_QUERY['compact_list']} tokens** (fixed, header-only)")
 187      lines.append(f"- Alias savings per query (JSON get): **{ALIAS_SAVINGS_PER_QUERY['json_get']} tokens**")
 188      lines.append(f"- Alias savings per query (JSON list, {AVG_LIST_ITEMS} items): **{ALIAS_SAVINGS_PER_QUERY['json_list_per_item'] * AVG_LIST_ITEMS} tokens**")
 189      lines.append("")
 190      lines.append("## Query Mix Assumptions")
 191      lines.append("")
 192      for qtype, prop in QUERY_MIX.items():
 193          lines.append(f"- {qtype}: {prop*100:.0f}%")
 194      lines.append(f"- Average items per list(): {AVG_LIST_ITEMS}")
 195      lines.append("")
 196  
 197      # =========================================================================
 198      # TABLE 1: Compact format results
 199      # =========================================================================
 200      lines.append("## Results: Compact Format")
 201      lines.append("")
 202      lines.append("| Session Length | Eviction K | Schema Calls | Schema Cost | Alias Savings | Net Balance | Break-Even |")
 203      lines.append("|--------------:|-----------:|-------------:|------------:|--------------:|------------:|-----------:|")
 204  
 205      for r in results:
 206          if r["output_format"] != "compact":
 207              continue
 208          be = f"{r['break_even_queries']:.0f}" if r["break_even_queries"] != float('inf') else "never"
 209          evict = format_eviction(r["eviction_rate"])
 210          net_sign = "+" if r["net_balance"] > 0 else ""
 211          lines.append(
 212              f"| {r['session_length']} | {evict} | {r['schema_calls']} | "
 213              f"{r['total_schema_cost']} | {r['total_alias_savings']} | "
 214              f"{net_sign}{r['net_balance']} | {be} |"
 215          )
 216  
 217      lines.append("")
 218  
 219      # =========================================================================
 220      # TABLE 2: JSON format results
 221      # =========================================================================
 222      lines.append("## Results: JSON Format")
 223      lines.append("")
 224      lines.append("| Session Length | Eviction K | Schema Calls | Schema Cost | Alias Savings | Net Balance | Break-Even |")
 225      lines.append("|--------------:|-----------:|-------------:|------------:|--------------:|------------:|-----------:|")
 226  
 227      for r in results:
 228          if r["output_format"] != "json":
 229              continue
 230          be = f"{r['break_even_queries']:.0f}" if r["break_even_queries"] != float('inf') else "never"


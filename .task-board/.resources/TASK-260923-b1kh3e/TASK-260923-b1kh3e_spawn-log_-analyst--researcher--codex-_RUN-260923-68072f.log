 318  // parseQuery parses the top-level batch: query (';' query)*
 319  func (p *parser) parseQuery() (*Query, error) {
 320  	q := &Query{}
 321  
 322  	// Skip leading semicolons
 323  	for p.peek().typ == tokenSemicolon {
 324  		p.advance()
 325  	}
 326  
 327  	if p.peek().typ == tokenEOF {
 328  		pos := p.tzer.posAt(p.peek().pos)
 329  		return nil, &ParseError{
 330  			Message: "empty query",
 331  			Pos:     pos,
 332  			Got:     "end of input",
 333  		}
 334  	}
 335  
 336  	for {
 337  		stmt, err := p.parseStatement()
 338  		if err != nil {
 339  			return nil, err
 340  		}
 341  		q.Statements = append(q.Statements, *stmt)
 342  
 343  		// Skip semicolons between statements
 344  		if p.peek().typ == tokenSemicolon {
 345  			for p.peek().typ == tokenSemicolon {
 346  				p.advance()
 347  			}
 348  			if p.peek().typ == tokenEOF {
 349  				break
 350  			}
 351  			continue
 352  		}
 353  
 354  		if p.peek().typ == tokenEOF {
 355  			break
 356  		}
 357  
 358  		// Neither semicolon nor EOF — unexpected token
 359  		tok := p.peek()
 360  		pos := p.tzer.posAt(tok.pos)
 361  		return nil, &ParseError{
 362  			Message:  "expected ';' or end of input",
 363  			Pos:      pos,
 364  			Got:      tok.val,
 365  			Expected: "';' or end of input",
 366  		}
 367  	}
 368  
 369  	return q, nil
 370  }
   1  package agentquery
   2  
   3  import (
   4  	"encoding/json"
   5  	"fmt"
   6  	"strings"
   7  )
   8  
   9  // FormatCompact formats a query result in compact tabular format.
  10  // fieldOrder provides column ordering for tabular output.
  11  //
  12  // For list results ([]map[string]any or []any containing maps):
  13  // header row with comma-separated field names, then one row per item.
  14  //
  15  // For single object results (map[string]any with no "error" key):
  16  // key:value pairs, one per line.
  17  //
  18  // For other results (summary, schema introspection, errors, non-map types):
  19  // falls back to JSON marshaling.
  20  func FormatCompact(result any, fieldOrder []string) ([]byte, error) {
  21  	switch v := result.(type) {
  22  	case []map[string]any:
  23  		return formatList(v, fieldOrder)
  24  	case []any:
  25  		return formatAnyList(v, fieldOrder)
  26  	case map[string]any:
  27  		// Error maps fall through to JSON.
  28  		if _, hasError := v["error"]; hasError {
  29  			return json.Marshal(v)
  30  		}
  31  		return formatSingle(v, fieldOrder)
  32  	default:
  33  		return json.Marshal(result)
  34  	}
  35  }
  36  
  37  // formatList formats a slice of maps as a CSV-style table.
  38  func formatList(items []map[string]any, fieldOrder []string) ([]byte, error) {
  39  	if len(fieldOrder) == 0 && len(items) > 0 {
  40  		// No explicit field order — derive from first item's keys.
  41  		// This is a fallback; normally fieldOrder is provided by the query.
  42  		fieldOrder = mapKeys(items[0])
  43  	}
  44  
  45  	var b strings.Builder
  46  
  47  	// Header row
  48  	b.WriteString(strings.Join(fieldOrder, ","))
  49  	b.WriteByte('\n')
  50  
  51  	// Data rows
  52  	for _, item := range items {
  53  		for i, field := range fieldOrder {
  54  			if i > 0 {
  55  				b.WriteByte(',')
  56  			}
  57  			b.WriteString(escapeCSV(item[field]))
  58  		}
  59  		b.WriteByte('\n')
  60  	}
  61  
  62  	return []byte(b.String()), nil
  63  }
  64  
  65  // formatAnyList tries to interpret []any as a list of maps for tabular output.
  66  // If any element is not a map, falls back to JSON.
  67  func formatAnyList(items []any, fieldOrder []string) ([]byte, error) {
  68  	maps := make([]map[string]any, 0, len(items))
  69  	for _, item := range items {
  70  		m, ok := item.(map[string]any)
  71  		if !ok {
  72  			// Mixed types — fall back to JSON.
  73  			return json.Marshal(items)
  74  		}
  75  		maps = append(maps, m)
  76  	}
  77  	return formatList(maps, fieldOrder)
  78  }
  79  
  80  // formatSingle formats a single map as key:value pairs, one per line.
  81  func formatSingle(m map[string]any, fieldOrder []string) ([]byte, error) {
  82  	if len(fieldOrder) == 0 || !hasOverlap(fieldOrder, m) {
  83  		fieldOrder = mapKeys(m)
  84  	}
  85  
  86  	var b strings.Builder
  87  	for _, field := range fieldOrder {
  88  		val := m[field]
  89  		b.WriteString(field)
  90  		b.WriteByte(':')
  91  		b.WriteString(escapeKV(val))
  92  		b.WriteByte('\n')
  93  	}
  94  	return []byte(b.String()), nil
  95  }
  96  
  97  // escapeCSV converts a value to a string suitable for a CSV cell.
  98  // Nil values become empty string. Values containing commas, quotes,
  99  // or newlines are wrapped in double quotes with internal quotes doubled.
 100  func escapeCSV(val any) string {
 101  	if val == nil {
 102  		return ""
 103  	}
 104  	s := formatValue(val)
 105  	if strings.ContainsAny(s, ",\"\n\r") {
 106  		return `"` + strings.ReplaceAll(s, `"`, `""`) + `"`
 107  	}
 108  	return s
 109  }
